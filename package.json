{
  "version": "0.0.1",
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": ">=10",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "0.13.1"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.109.0",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@types/prismjs": "1.26.3",
    "eslint": "latest",
    "husky": "latest",
    "prettier": "3.8.3",
    "typescript": ">=5"
  },
  "scripts": {
    "build": "build-figma-plugin --minify",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "watch": "build-figma-plugin --watch",
    "prepare": "husky"
  },
  "figma-plugin": {
    "editorType": [
      "figma"
    ],
    "id": "com.thesrijak.ai2design",
    "name": "AI2Design",
    "main": "src/main.ts",
    "ui": "src/ui.tsx"
  }
}
